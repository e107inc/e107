includes:
	- dynamic-constants.php

parameters:
	level: 8

	# The runtime window master supports: the platform pin in the root
	# composer.json is the floor, the highest version CI runs is the ceiling.
	phpVersion:
		min: 80000
		max: 80599

	# What e107 declares at run time and no analyser follows: the e_db and
	# e_db_common class aliases, and every constant the tracked tree defines.
	# A constant nothing defines is still reported, misspellings included.
	bootstrapFiles:
		- bootstrap.php

	excludePaths:
		# Not e107's product code, and nothing in it defines a symbol the product
		# code refers to.
		analyseAndScan:
			- ../../../.github
			- ../../../e107_tests
		# Read for the symbols they define, never analysed: a dependency's own
		# findings are not e107's worklist.
		analyse:
			- ../../../e107_handlers/vendor
			- ../../../e107_plugins/*/tests/*
			- ../../../e107_plugins/*/vendor/*

	tmpDir: tmp
