{
  "name": "e107inc/e107-test",
  "description": "Test harness for e107",
  "license": "GPL-3.0-or-later",
  "require-dev": {
    "twig/twig": "^1.28 || >=3.14.1",
    "codeception/codeception": "^4.2 || >=5.0.11",
    "codeception/module-asserts": "^1.1 || >=3.0.0",
    "codeception/module-db": "^1.0 || >=3.1.2",
    "codeception/module-phpbrowser": "^1.0 || >=1.1.0",
    "codeception/module-filesystem": "^1.0 || >=3.0.0",
    "codeception/module-webdriver": "^1.0 || >=4.0.0"
  },
  "config": {
    "audit": {
      "block-insecure": false
    },
    "optimize-autoloader": true,
    "platform": {
      "php": "8.1.33"
    },
    "preferred-install": "dist",
    "sort-packages": true
  }
}
